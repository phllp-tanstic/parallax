# Parallax — environment variables
# Copy to .env and fill in. Never commit .env.

# JSON-RPC endpoint for X Layer. Used by Hardhat for deploys, forked-state
# integration tests, and by the off-chain risk engine to read chain state.
X_LAYER_RPC_URL=

# Deployer / operator EOA private key. Signs contract deployments and any
# privileged protocol transactions. Use a throwaway key outside of production.
PRIVATE_KEY=

# Address of the Aave lending pool on X Layer. The yield venue where the
# principal-protection leg is deposited to accrue the protected floor.
AAVE_POOL_ADDRESS=

# Address of the Chainlink price feed (aggregator) for the note's underlying.
# Source of truth for valuation, payoff calculation, and settlement.
CHAINLINK_FEED_ADDRESS=
