# Parallax — environment variables
# Copy to .env and fill in. Never commit .env.

# X Layer mainnet RPC (no path suffix)
X_LAYER_RPC_URL=https://rpc.xlayer.tech

# X Layer testnet RPC — note the /terigon path suffix, do not omit it
X_LAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon

# Deployer private key — never commit a real value here
PRIVATE_KEY=

# Address of the Aave lending pool on X Layer. The yield venue where the
# principal-protection leg is deposited to accrue the protected floor.
AAVE_POOL_ADDRESS=

# Address of the Chainlink price feed (aggregator) for the note's underlying.
# Source of truth for valuation, payoff calculation, and settlement.
CHAINLINK_FEED_ADDRESS=
